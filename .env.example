# The model key never reaches the client. It is read by the server only.
#
# If MINIMAX_API_KEY is already in your shell's environment, that wins over this
# file — neither Next nor tsx overrides a variable that is already set — and a
# wrong key there fails as a 401 that looks like a stale key here. `unset
# MINIMAX_API_KEY` before `npm run dev` or `npm run probe:model` if you are not
# sure which one you are using.
MINIMAX_API_KEY=

# Region host. `cn` for api.minimaxi.com, `global` for api.minimax.io.
MINIMAX_REGION=cn

# See docs/adr/0001-*.md: every M2.x model reasons before it speaks, which puts
# the first sentence at ~3s. This one does not, and is the only measured model
# that fits the 700-900ms first-sentence budget. Override to trade latency for
# reasoning quality.
MINIMAX_MODEL=abab6.5s-chat

# A turn that has not produced a complete reply within this many ms fails, and
# costs the learner nothing.
TURN_TIMEOUT_MS=15000

# The sprint clock is what ends a scene, and it is the same for every learner:
# six minutes, five of them, about half an hour. A turn count could not do that,
# because the learner sets the pace — eight turns is two and a half minutes for a
# fast learner and seven for a slow one.
SPRINT_MS=360000
SESSION_MS=1800000

# A cap, not a target. It only fires when a learner is getting through twenty
# turns inside one sprint, which stops a brisk exchange from running long without
# deciding how long anyone's practice is.
SPRINT_TURNS=20

# Sprints in one session. Clamped to 4-6, and to how many scenes the chosen
# scenario has. This is also the New Word budget's new half: each scene brings one
# New Word of its own, so five sprints is five new words and DECK below makes ten.
SPRINTS_PER_SESSION=5

# How many Fumble Deck words this session aims to put back in play. Worst offenders
# first, capped here, because the deck itself is unbounded: naming every word the
# learner has ever fumbled is worse than naming five, because a partner handed a
# long list builds a situation requiring none of them.
DECK_WORDS_PER_SESSION=5

# A sprint never carries more than 3 New Words, and that one is deliberately NOT
# configurable here. It is a correctness boundary rather than a tuning knob: a scene
# with four new words in it has stopped being a conversation.

# Local relational store, always under ./data. Server-side state is the source of
# truth for a session. The value names a file inside ./data, nothing else.
DATABASE_FILE=japanese-trainer.db

# Point the model call at a local endpoint to exercise the failure and timeout
# paths without spending a model call. Leave unset for normal use.
# MOCK_MODEL_URL=http://127.0.0.1:9999/v1/chat/completions
