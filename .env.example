# The model key never reaches the client. It is read by the server only.
#
# If MINIMAX_API_KEY is already in your shell's environment, that wins over this
# file — neither Next nor tsx overrides a variable that is already set — and a
# wrong key there fails as a 401 that looks like a stale key here. `unset
# MINIMAX_API_KEY` before `npm run dev` or `npm run probe:model` if you are not
# sure which one you are using.
MINIMAX_API_KEY=

# Region host. `cn` for api.minimaxi.com, `global` for api.minimax.io.
MINIMAX_REGION=cn

# See docs/adr/0001-*.md: every M2.x model reasons before it speaks, which puts
# the first sentence at ~3s. This one does not, and is the only measured model
# that fits the 700-900ms first-sentence budget. Override to trade latency for
# reasoning quality.
MINIMAX_MODEL=abab6.5s-chat

# A turn that has not produced a complete reply within this many ms fails, and
# costs the learner nothing.
TURN_TIMEOUT_MS=15000

# The sprint clock is what ends a scene, and it is the same for every learner:
# six minutes, five of them, about half an hour. A turn count could not do that,
# because the learner sets the pace — eight turns is two and a half minutes for a
# fast learner and seven for a slow one.
SPRINT_MS=360000
SESSION_MS=1800000

# A cap, not a target. It only fires when a learner is getting through twenty
# turns inside one sprint, which stops a brisk exchange from running long without
# deciding how long anyone's practice is.
SPRINT_TURNS=20

# Sprints in one session. Clamped to 4-6, and to how many scenes the chosen
# scenario has.
SPRINTS_PER_SESSION=5

# Local relational store, always under ./data. Server-side state is the source of
# truth for a session. The value names a file inside ./data, nothing else.
DATABASE_FILE=japanese-trainer.db

# Point the model call at a local endpoint to exercise the failure and timeout
# paths without spending a model call. Leave unset for normal use.
# MOCK_MODEL_URL=http://127.0.0.1:9999/v1/chat/completions


# --- The partner's voice -------------------------------------------------------
#
# TTS is called on demand from a play button, never on the turn path, so nothing
# here affects turn latency. Every one of these settings is part of the cache key
# (docs/adr/0007-partner-speech.md): change one and the affected audio is
# re-synthesised rather than served stale. No manual cache purge exists, and that
# is the intent.

# Reuses MINIMAX_API_KEY and MINIMAX_REGION. Note that a CN key is rejected by
# the global host and vice versa, so the region and the key have to agree.
TTS_MODEL=speech-2.8-hd

# Every Japanese system voice id is listed at
# https://platform.minimax.io/docs/faq/system-voice-id. The default suits the
# izakaya scenario and is not wrong for the other two.
TTS_VOICE_ID=Japanese_GenerousIzakayaOwner

# Speed is NOT validated server-side: an out-of-range value is synthesised without
# complaint. The client clamps to these ranges.
TTS_SPEED=1.0
TTS_VOLUME=1.0
TTS_PITCH=0

# One of: happy, sad, angry, fearful, disgusted, surprised, calm, fluent,
# whisper. An unrecognised value is ignored rather than sent, because the service
# rejects an invalid one outright.
# TTS_EMOTION=calm

TTS_LANGUAGE_BOOST=Japanese

# Comma-separated "surface/replacement" rules applied before synthesis, which is
# the only place a misread word can be corrected. Half-width parens for kana:
#   TTS_PRONUNCIATION_DICT=東京/トウキョウ,の/no
# TTS_PRONUNCIATION_DICT=

# Roughly 3MB of unique lines per session, so this holds months of practice.
# Least-recently-used entries are dropped once the cap is passed.
TTS_CACHE_MB=256

TTS_TIMEOUT_MS=20000

# Point the voice call at a local endpoint to exercise the failure path — a
# refused call, a hanging call, a bad voice id — without spending characters.
# MOCK_TTS_URL=http://127.0.0.1:9999/v1/t2a_v2
